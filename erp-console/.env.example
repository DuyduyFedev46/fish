# URL gốc của Django API. Mặc định khi không set: http://localhost:8000
# Build để deploy cangca-erp phải set URL Cloud Run cangca-api.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Đặt = 1 để console dùng dữ liệu mock (khi backend chưa có endpoint). 0/bỏ trống = gọi API thật.
NEXT_PUBLIC_USE_MOCK=1
