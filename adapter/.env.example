# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Base URL của Django nội bộ (không có dấu / ở cuối cũng được, adapter tự strip).
DJANGO_INTERNAL_URL=http://127.0.0.1:8000

# Token dùng để adapter tự xác thực với Django qua header X-Internal-Token.
# Phải trùng với giá trị Django cấu hình cho endpoint /api/internal/payments/sepay-webhook/.
INTERNAL_SERVICE_TOKEN=doi-gia-tri-nay-thanh-secret-that

# Secret dùng để xác thực IPN Cổng thanh toán SePay (POST /ipn/sepay) — KÊNH CHÍNH V1.
# Cấu hình kiểu xác thực IPN trên dashboard SePay = SECRET_KEY, gửi kèm header:
#   X-Secret-Key: <SEPAY_SECRET_KEY>
# So khớp hằng-thời-gian (hmac.compare_digest). BẮT BUỘC.
SEPAY_SECRET_KEY=doi-gia-tri-nay-thanh-secret-that

# (Tuỳ chọn, mặc định false) Bật/tắt route CŨ POST /webhook/sepay (webhook biến động số dư
# ngân hàng). V1 (hồ sơ 2026-09-26-sepay-cong-thanh-toan, quyết định Duy): CHỈ dùng IPN
# Cổng thanh toán ở trên — route này giữ code nhưng TẮT. Khi false, KHÔNG cần khai
# SEPAY_WEBHOOK_SECRET (khởi động vẫn chạy). Khi true, SEPAY_WEBHOOK_SECRET bắt buộc.
# SEPAY_BANK_WEBHOOK_ENABLED=false

# Secret dùng để xác thực webhook SePay CŨ (biến động số dư) gửi tới adapter — chỉ cần khi
# SEPAY_BANK_WEBHOOK_ENABLED=true. Cấu hình trên dashboard SePay (mục Cấu hình Webhooks)
# theo phương thức "API Key": Authorization: Apikey <SEPAY_WEBHOOK_SECRET>
# SEPAY_WEBHOOK_SECRET=doi-gia-tri-nay-thanh-secret-that

# (Tuỳ chọn) Regex dự phòng để rút mã đơn hàng từ nội dung chuyển khoản khi
# SePay không tự nhận diện được vào field `code`. Mặc định: 1-4 chữ cái + >=4 số,
# vd DH0001234. Chỉnh lại khi Agent A (sales) chốt format order_code thật.
# Chỉ dùng cho route webhook CŨ (biến động số dư) — IPN Cổng thanh toán không dùng regex này.
# ORDER_CODE_REGEX=[A-Z]{1,4}[0-9]{4,}

# (Tuỳ chọn) Timeout/retry khi gọi Django nội bộ.
# DJANGO_REQUEST_TIMEOUT_SECONDS=10
# DJANGO_REQUEST_RETRIES=2
