# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env.
# Bỏ trống DATABASE_URL để dùng SQLite (chỉ cho dev/máy chưa cài Postgres).
# DEBUG mặc định TẮT khi không khai báo. Dev local: giữ DJANGO_DEBUG=1 (khi đó được phép bỏ
# trống DJANGO_SECRET_KEY — dùng key dev). Production: DJANGO_DEBUG=0 và DJANGO_SECRET_KEY bí mật,
# thiếu/để placeholder dưới đây thì Django dừng ngay khi khởi động (ImproperlyConfigured).
DJANGO_SECRET_KEY=đổi-thành-chuỗi-ngẫu-nhiên-dài
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Sản phẩm: PostgreSQL (quyết định stack đã chốt).
# DATABASE_URL=postgres://loc:loc@localhost:5432/cangca

# Ngưỡng cấu hình được (business-process-spec.md) — không hard-code trong logic.
BATCH_DEFAULT_SHELF_LIFE_DAYS=365
BATCH_NEAR_EXPIRY_DAYS=14
SALES_ORDER_TTL_MINUTES=30
DELIVERY_MAX_FAILED_ATTEMPTS=2
# Ngưỡng giờ ngoài chuỗi lạnh để mặc định đề xuất huỷ hàng hoàn (câu hỏi mở #3 — cần Lộc cho số thật).
COLD_CHAIN_MAX_HOURS=6

# Token nội bộ FastAPI adapter -> Django (chi tiết cơ chế để lúc build Phase 4).
INTERNAL_SERVICE_TOKEN=đổi-thành-token-nội-bộ

# Cổng thanh toán SePay (doc/features/2026-09-26-sepay-cong-thanh-toan) — BR-TT-14.
# Giá trị THẬT nằm ở GCP Secret Manager (cangca-sepay-sandbox-merchant-id /
# cangca-sepay-sandbox-secret-key). KHÔNG commit giá trị thật vào đây.
SEPAY_ENV=SANDBOX
SEPAY_MERCHANT_ID=đổi-thành-merchant-id-sepay
SEPAY_SECRET_KEY=đổi-thành-secret-key-sepay
SEPAY_CHECKOUT_URL_SANDBOX=https://pay-sandbox.sepay.vn/v1/checkout/init
SEPAY_CHECKOUT_URL_PRODUCTION=https://pay.sepay.vn/v1/checkout/init
# Domain Shop (Firebase cangca-loc) — success/cancel/error_url của P1 trỏ về đây.
SHOP_BASE_URL=http://localhost:3000
